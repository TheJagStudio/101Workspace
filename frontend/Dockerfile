FROM node:20-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

# Vite embeds VITE_* variables at build time (not runtime).
ARG VITE_SERVER_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_SUPABASE_URL_SECOND
ARG VITE_SUPABASE_ANON_KEY_SECOND

ENV VITE_SERVER_URL=$VITE_SERVER_URL \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_SUPABASE_URL_SECOND=$VITE_SUPABASE_URL_SECOND \
    VITE_SUPABASE_ANON_KEY_SECOND=$VITE_SUPABASE_ANON_KEY_SECOND

RUN npm run build

# Install serve to run the production build
RUN npm install -g serve

EXPOSE 5173

CMD ["serve", "-s", "dist", "-l", "5173"]